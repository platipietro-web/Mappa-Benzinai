rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Stazioni (lettura pubblica, scrittura autenticati) ─────────────────────
    match /stations/{stationId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Aggiornamenti prezzi: autenticati
      match /price_updates/{updateId} {
        allow read: if true;
        allow create: if request.auth != null;
      }

      // Storico prezzi: lettura pubblica, scrittura autenticati
      match /price_history/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // ── Utenti (solo il proprietario) ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Preferiti
      match /favorites/{stationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Log rifornimenti: solo il proprietario può leggere e scrivere
      match /refueling_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
