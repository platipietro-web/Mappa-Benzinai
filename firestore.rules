rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────────

    // Prezzo carburante valido: numero positivo entro un range realistico (€/L)
    function isValidPrice(price) {
      return price is number && price > 0.1 && price < 10.0;
    }

    // Mappa di prezzi valida (es. {"Benzina": 1.85, "Diesel": 1.70})
    function hasValidPrices(data) {
      return !('prices' in data) ||
             data.prices is map;
    }

    // Stringa non vuota con lunghezza massima
    function isValidString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // ── Stazioni (lettura pubblica, scrittura autenticati + validazione) ───────
    match /gas_stations/{stationId} {
      allow read: if true;

      // Solo utenti autenticati possono creare/modificare stazioni
      // I dati devono rispettare i campi attesi
      allow create: if request.auth != null
                    && isValidString(request.resource.data.name, 200)
                    && hasValidPrices(request.resource.data);

      allow update: if request.auth != null
                    && hasValidPrices(request.resource.data);

      allow delete: if false; // le stazioni non si eliminano dall'app

      // Aggiornamenti prezzi: autenticati + prezzo valido
      match /price_updates/{updateId} {
        allow read: if true;
        allow create: if request.auth != null
                      && isValidPrice(request.resource.data.price)
                      && isValidString(request.resource.data.fuelType, 50);
        allow update, delete: if false;
      }

      // Storico prezzi: lettura pubblica, scrittura autenticati + validazione
      match /price_history/{docId} {
        allow read: if true;
        allow create: if request.auth != null
                      && isValidPrice(request.resource.data.price);
        allow update, delete: if false;
      }
    }

    // ── Celle import OSM (cooldown condiviso, evita chiamate Overpass ripetute)
    match /import_cells/{cellId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Log errori servizi esterni senza dashboard (Nominatim/Overpass) ────
    // Nessuna lettura client: consultati solo dalla console Firebase.
    match /service_errors/{errorId} {
      allow read: if false;
      allow create: if isValidString(request.resource.data.serviceName, 50);
      allow update, delete: if false;
    }

    // ── Autolavaggi (lettura pubblica, scrittura autenticati + validazione) ──
    match /car_washes/{washId} {
      allow read: if true;
      allow create: if request.auth != null
                    && isValidString(request.resource.data.name, 200);
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ── Utenti (solo il proprietario) ─────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Preferiti benzinai
      match /favorites/{stationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Preferiti autolavaggi
      match /car_wash_favorites/{washId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Log rifornimenti: solo il proprietario + validazione campi obbligatori
      match /refueling_logs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && isValidPrice(request.resource.data.pricePerLiter)
                      && request.resource.data.liters is number
                      && request.resource.data.liters > 0;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Veicoli: solo il proprietario
      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Spese veicolo (assicurazione, bollo, manutenzione, altro)
        match /cost_entries/{entryId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
